# Copy to .env and fill in. Never commit .env.

# Leave empty to run the offline extractive baseline (no API calls, no cost).
ANTHROPIC_API_KEY=

# auto | anthropic | offline  (auto = anthropic when ANTHROPIC_API_KEY is set)
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=1.0

# memory | redis | none
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=30
# Reverse proxies / load balancers in front of the API (0 = clients connect directly).
# Set this correctly: too high lets clients forge X-Forwarded-For and dodge the rate limit.
TRUSTED_PROXY_HOPS=0
